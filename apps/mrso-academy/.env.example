# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.
# Both values are on Supabase → Project Settings → API. Leave empty to run in local demo mode (no accounts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEVER put the service_role key in this app.
