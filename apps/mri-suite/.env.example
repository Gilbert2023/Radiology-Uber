# PostgreSQL connection (use sslmode=require in production)
DATABASE_URL=postgres://mri:mri_dev_password@localhost:5432/mri_suite
# Separate database used by the automated test suite (it is wiped on every run)
TEST_DATABASE_URL=postgres://mri:mri_dev_password@localhost:5432/mri_suite_test
# Absolute or relative path for uploaded documents (must NOT be inside /public)
UPLOAD_DIR=./storage/uploads
# Session lifetime and idle timeout (minutes)
SESSION_MAX_AGE_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=30
# Set to "true" behind HTTPS so cookies are flagged Secure
COOKIE_SECURE=false
