# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Local development:
DATABASE_URL=postgres://mri:mri_dev_password@localhost:5432/mri_suite
# Supabase on Vercel – use the TRANSACTION pooler (port 6543), from
# Supabase → Project Settings → Database → Connection string → "Transaction pooler":
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For running migrations from your computer use the SESSION pooler (port 5432) instead.
#
# TLS: set ONE of these for Supabase (DATABASE_CA_CERT is recommended – it verifies the server).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL=require
#
# Keep each serverless instance's pool small on Vercel:
# DATABASE_POOL_MAX=3

# Separate database used by the automated tests (it is WIPED on every run)
TEST_DATABASE_URL=postgres://mri:mri_dev_password@localhost:5432/mri_suite_test

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# On Vercel you MUST use Supabase Storage (Vercel's disk is temporary). Server-side only – never expose.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from Supabase → Project Settings → API>
# SUPABASE_STORAGE_BUCKET=mri-documents
# Local / on-premise alternative (ignored when Supabase is configured):
UPLOAD_DIR=./storage/uploads

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_MAX_AGE_MINUTES=720
# Set to "true" whenever the site is served over HTTPS (always true on Vercel)
COOKIE_SECURE=false
