{
  "name": "mri-suite",
  "version": "1.0.0",
  "private": true,
  "description": "The Bank Hospital \u2013 MRI Suite Management System",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "setup:storage": "tsx scripts/setup-storage.ts",
    "setup:production": "tsx scripts/migrate.ts && tsx scripts/seed.ts --reference-only && tsx scripts/setup-storage.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "0.544.0",
    "next": "15.5.29",
    "pdfkit": "0.21.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
